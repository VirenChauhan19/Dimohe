<section class="section brand-story customer-account"><h1>Your account</h1><p>{{ customer.name | escape }}</p><a href="{{ routes.account_logout_url }}">Sign out</a><h2>Orders</h2>{% paginate customer.orders by 20 %}{% for order in customer.orders %}<p><a href="{{ order.customer_url }}">{{ order.name | escape }}</a> · {{ order.created_at | date: '%B %d, %Y' }} · {{ order.total_price | money }} · {{ order.financial_status_label | escape }}</p>{% else %}<p>No orders yet.</p>{% endfor %}{{ paginate | default_pagination }}{% endpaginate %}<h2>Your address</h2>{{ customer.default_address | format_address }}<a href="{{ routes.account_addresses_url }}">Manage addresses</a></section>
