<section class="section edit-section"><div class="section-title"><div><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.intro | escape }}</p></div>{% if section.settings.collection != blank %}<a class="text-link" href="{{ section.settings.collection.url }}">{{ section.settings.link_label | escape }}</a>{% endif %}</div><div class="picks-categories" aria-label="Browse our picks by category">{% for block in section.blocks %}<button type="button" data-picks-category="{{ block.id }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.title | escape }}</button>{% endfor %}</div>{% for block in section.blocks %}<div class="product-grid" data-pick-group="{{ block.id }}"{% unless forloop.first %} hidden{% endunless %}>{% assign items = block.settings.products | default: block.settings.collection.products %}{% for product in items limit: 2 %}{% render 'product-card', product: product %}{% else %}{% if request.design_mode %}<p>Choose a collection or products for this tab.</p>{% endif %}{% endfor %}</div>{% endfor %}</section>

{% schema %}
{
  "name": "Our Picks",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Picks"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Introduction",
      "default": "A few favourites, by category."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "See all collection"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "See all our picks"
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "tab",
      "name": "Department tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Collection"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Featured products",
          "limit": 2
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Picks"
    }
  ]
}
{% endschema %}
