<section class="section journal-page"><p class="breadcrumbs"><a href="{{ routes.root_url }}">Home</a> / The blogs</p><header class="journal-intro"><p class="eyebrow">CRAFT & EVERYDAY LIVING</p><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.intro | escape }}</p></header>{% paginate blog.articles by 12 %}<div class="journal-grid">{% for article in blog.articles %}{% assign override_image = false %}{% assign override_asset = '' %}{% for block in section.blocks %}{% if block.settings.article.id == article.id %}{% assign override_image = block.settings.image %}{% assign override_asset = block.settings.asset %}{% endif %}{% endfor %}<article class="journal-card"><a class="journal-image" href="{{ article.url }}">{% if override_image or override_asset != blank %}{% render 'theme-image', image: override_image, asset: override_asset, alt: article.title, loading: 'lazy', sizes: '(max-width: 767px) 90vw, 45vw' %}{% elsif article.image %}{{ article.image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '360,550,750,1100', sizes: '(max-width: 767px) 90vw, 45vw', alt: article.title }}{% endif %}</a><div class="journal-copy"><h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2><p>{{ article.excerpt_or_content | strip_html | truncatewords: 32 }}</p></div></article>{% else %}<p>No stories have been published here yet.</p>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}</section>

{% schema %}
{
  "name": "The blogs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The blogs"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Stories behind the handwork, and ideas for living with the pieces you love."
    }
  ],
  "blocks": [
    {
      "type": "cover",
      "name": "Article cover override",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Bundled image filename",
          "default": "none"
        }
      ]
    }
  ]
}
{% endschema %}
