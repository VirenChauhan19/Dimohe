{% if items != blank %}<section class="section department-products" aria-label="{{ heading | escape }} products" data-product-carousel><div class="rail-toolbar"><p>In the collection</p><div class="rail-controls"><button type="button" data-rail-prev aria-label="Previous {{ heading | escape }} products" aria-controls="Rail-{{ rail_id }}" disabled><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m14 5-7 7 7 7"/></svg></button><button type="button" data-rail-next aria-label="Next {{ heading | escape }} products" aria-controls="Rail-{{ rail_id }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m10 5 7 7-7 7"/></svg></button></div></div><div class="product-rail" id="Rail-{{ rail_id }}" role="region" aria-label="{{ heading | escape }}" tabindex="0">{% for product in items limit: limit %}{% render 'product-card', product: product %}{% endfor %}</div><p class="rail-hint">Swipe or scroll to explore</p></section>{% endif %}
