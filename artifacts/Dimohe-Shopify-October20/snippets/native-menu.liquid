<nav class="desktop-nav" aria-label="Main navigation">{% for link in menu.links %}{% if link.links != blank %}<details class="nav-group"><summary>{{ link.title | escape }}</summary><div class="nav-panel"><div class="nav-panel-inner"><div class="nav-panel-heading"><a href="{{ link.url }}">{{ link.title | escape }}</a></div><div class="nav-columns">{% for child in link.links %}<div class="nav-room"><h3><a href="{{ child.url }}">{{ child.title | escape }}</a></h3>{% for leaf in child.links %}<a href="{{ leaf.url }}">{{ leaf.title | escape }}</a>{% endfor %}</div>{% endfor %}</div></div></div></details>{% else %}<a class="nav-plain" href="{{ link.url }}">{{ link.title | escape }}</a>{% endif %}{% endfor %}</nav>
<nav class="mobile-nav" aria-label="Mobile navigation" hidden><a href="{{ routes.root_url }}">Home</a>{% for link in menu.links %}{% if link.links != blank %}<details><summary>{{ link.title | escape }}</summary><a href="{{ link.url }}">{{ link.title | escape }}</a><div class="mobile-department-links">{% for child in link.links %}<div class="nav-room"><h3><a href="{{ child.url }}">{{ child.title | escape }}</a></h3>{% for leaf in child.links %}<a href="{{ leaf.url }}">{{ leaf.title | escape }}</a>{% endfor %}</div>{% endfor %}</div></details>{% else %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endif %}{% endfor %}</nav>
