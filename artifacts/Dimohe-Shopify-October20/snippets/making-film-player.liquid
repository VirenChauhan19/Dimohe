<figure class="making-film-player {{ player_class | escape }}"><video controls playsinline preload="none" poster="{{ poster | asset_url }}" width="{{ width | default: 540 }}" height="{{ height | default: 960 }}" aria-label="{{ title | escape }}"><source src="{{ asset | asset_url }}" type="video/mp4"></video>{% if caption != blank %}<figcaption>{{ caption | escape }}</figcaption>{% endif %}</figure>
