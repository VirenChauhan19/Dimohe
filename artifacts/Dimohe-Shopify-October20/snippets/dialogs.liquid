<dialog id="search-dialog" class="search-dialog"><div class="dialog-heading"><h2>Search</h2><button class="icon-button" type="button" data-close-dialog aria-label="Close search">{% render 'icon-close' %}</button></div><form action="{{ routes.search_url }}" class="search-form" method="get"><label class="sr-only" for="SearchInput">Search products</label><input id="SearchInput" name="q" type="search" placeholder="Search products, crafts or places…" required><input type="hidden" name="type" value="product"><button class="button" type="submit">Search</button></form></dialog>
<dialog id="bag-dialog" class="bag-dialog"><div class="dialog-heading"><h2>Your shopping bag</h2><button class="icon-button" type="button" data-close-dialog aria-label="Close shopping bag">{% render 'icon-close' %}</button></div><div data-cart-content>{% render 'cart-content' %}</div></dialog>
<dialog id="quick-dialog" class="quick-dialog"><div class="dialog-heading"><span class="eyebrow">Product details</span><button class="icon-button" type="button" data-close-dialog aria-label="Close quick view">{% render 'icon-close' %}</button></div><div data-quick-content></div></dialog>
