{% assign share_url = shop.url | append: product.url %}{% assign share_image = product.featured_image | image_url: width: 1200 %}{% assign image_prefix = share_image | slice: 0, 2 %}{% if image_prefix == '//' %}{% assign share_image = share_image | prepend: 'https:' %}{% endif %}<details class="product-share"><summary>Share this piece</summary><div class="share-options"><button type="button" data-share-platform="Instagram" data-share-url="{{ share_url | escape }}" data-share-title="{{ product.title | escape }}">Instagram</button><a target="_blank" rel="noopener noreferrer" href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}">Facebook</a><button type="button" data-share-platform="TikTok" data-share-url="{{ share_url | escape }}" data-share-title="{{ product.title | escape }}">TikTok</button><a target="_blank" rel="noopener noreferrer" href="https://pinterest.com/pin/create/button/?url={{ share_url | url_encode }}&amp;media={{ share_image | url_encode }}&amp;description={{ product.title | url_encode }}">Pinterest</a><button type="button" data-copy-url="{{ share_url | escape }}">Copy link</button></div><p class="share-message" role="status"></p></details>