<form class="catalog-filters" method="get" action="{{ collection.url | default: routes.search_url }}">{% if request.page_type == 'search' %}<input name="q" type="hidden" value="{{ search.terms | escape }}"><input name="type" type="hidden" value="product">{% endif %}{% if results.filters != blank %}<details class="filter-details"><summary>Filter collection <span>+</span></summary><div class="filter-fields">{% for filter in results.filters %}<fieldset><legend>{{ filter.label | escape }}</legend>{% case filter.type %}{% when 'boolean', 'list' %}{% for value in filter.values %}<label class="checkbox"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}> {{ value.label | escape }} ({{ value.count }})</label>{% endfor %}{% when 'price_range' %}<label>Minimum price<input type="number" name="{{ filter.min_value.param_name }}" min="0" step="0.01"{% if filter.min_value.value %} value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}></label><label>Maximum price<input type="number" name="{{ filter.max_value.param_name }}" min="0" step="0.01"{% if filter.max_value.value %} value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}></label>{% endcase %}</fieldset>{% endfor %}<button class="button" type="submit">Apply filters</button></div></details>{% endif %}<div class="catalog-toolbar"><p>{{ count }} {% if count == 1 %}product{% else %}products{% endif %}</p><label>Sort by <select name="sort_by" data-sort>{% assign current_sort = results.sort_by | default: results.default_sort_by %}{% for option in results.sort_options %}<option value="{{ option.value }}"{% if current_sort == option.value %} selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select></label></div></form>
<div class="selected-filters">{% for filter in results.filters %}{% for value in filter.active_values %}<a href="{{ value.url_to_remove }}">{{ value.label | escape }} ×</a>{% endfor %}{% if filter.type == 'price_range' %}{% if filter.min_value.value != blank or filter.max_value.value != blank %}<a href="{{ filter.url_to_remove }}">Clear price ×</a>{% endif %}{% endif %}{% endfor %}</div>
