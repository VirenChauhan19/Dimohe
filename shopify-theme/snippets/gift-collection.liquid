<section class="section collection-intro"><p class="breadcrumbs"><a href="{{ routes.root_url }}">Home</a> / Gifts</p><h1>Gifts under $100</h1><p>Little finds for a home, a wardrobe, or a daily ritual. Selected using current product prices.</p></section><section class="section catalog-section">{% paginate collection.products by 250 %}<div class="product-grid">{% assign gift_count = 0 %}{% for product in collection.products %}{% assign gift_variant = false %}{% assign sorted_variants = product.variants | sort: 'price' %}{% for variant in sorted_variants %}{% if variant.available and variant.price < 10000 %}{% assign gift_variant = variant %}{% break %}{% endif %}{% endfor %}{% if gift_variant %}{% assign gift_count = gift_count | plus: 1 %}{% render 'product-card', product: product, card_variant: gift_variant %}{% endif %}{% endfor %}</div>{% if gift_count == 0 %}<p>No available pieces under 100 on this page. Browse another page or explore the full collection.</p>{% endif %}{% if paginate.pages > 1 %}<nav class="pagination" aria-label="Gift pages">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}<p class="gift-note">Prices are shown in {{ localization.country.currency.iso_code }}. The under-100 selection uses the current displayed currency.</p></section>
