{%- if product != blank -%}
{%- assign card_title = product.metafields.custom.card_title.value | default: product.title | remove_first: 'The ' -%}
{%- assign card_title = card_title | replace: 'Potli (Pochette) bag', 'Potli bag' | replace: 'Pochette', 'Potli bag' -%}
{%- assign card_url = product.url -%}{%- assign card_price = product.price -%}{%- assign card_compare = product.compare_at_price -%}{%- if card_variant != blank -%}{%- assign card_url = card_url | append: '?variant=' | append: card_variant.id -%}{%- assign card_price = card_variant.price -%}{%- assign card_compare = card_variant.compare_at_price -%}{%- endif -%}
<article class="product-card" data-product-handle="{{ product.handle }}"><a class="product-image" href="{{ card_url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '240,360,540,720,900', sizes: '(max-width: 767px) 46vw, 24vw', alt: card_title }}{% if product.images[1] %}{{ product.images[1] | image_url: width: 900 | image_tag: class: 'alternate', loading: 'lazy', widths: '240,360,540,720,900', sizes: '(max-width: 767px) 46vw, 24vw', alt: '' }}{% endif %}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}{% unless product.available %}<span class="tag">Sold out</span>{% endunless %}</a><button class="quick-view" type="button" data-quick-url="{{ card_url }}" aria-label="Quick view {{ card_title | escape }}">{% render 'icon-bag' %}</button><div class="product-caption"><a href="{{ card_url }}"><h3>{{ card_title | escape }}</h3></a><p class="product-subtitle">{{ product.metafields.custom.card_detail.value | default: product.type | escape }}</p><p class="price">{% if product.price_varies and card_variant == blank %}From {% endif %}{{ card_price | money }}{% if card_compare > card_price %} <s>{{ card_compare | money }}</s>{% endif %}</p></div></article>
{%- endif -%}
