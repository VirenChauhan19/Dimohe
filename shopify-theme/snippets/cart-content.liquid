{% if cart.item_count == 0 %}<p>Your shopping bag is empty.</p><a class="button" href="{{ routes.all_products_collection_url }}">Continue exploring</a>{% else %}<form action="{{ routes.cart_url }}" method="post" data-cart-form><div class="cart-items">{% for item in cart.items %}<div class="cart-item">{% if item.image %}<a href="{{ item.url }}">{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}</a>{% endif %}<div><h3><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}{% for property in item.properties %}{% assign first_char = property.first | slice: 0 %}{% if property.last != blank and first_char != '_' %}<p>{{ property.first | escape }}: {{ property.last | escape }}</p>{% endif %}{% endfor %}<p>{{ item.final_line_price | money }}</p>{% for allocation in item.line_level_discount_allocations %}<p>{{ allocation.discount_application.title | escape }} (−{{ allocation.amount | money }})</p>{% endfor %}<label class="cart-quantity">Quantity <input type="number" name="updates[]" aria-label="Quantity for {{ item.product.title | escape }}" value="{{ item.quantity }}" min="0" data-cart-key="{{ item.key | escape }}"></label><a href="{{ item.url_to_remove }}" data-cart-remove="{{ item.key | escape }}">Remove</a></div></div>{% endfor %}</div><label>Order note<textarea name="note">{{ cart.note | escape }}</textarea></label>{% for allocation in cart.cart_level_discount_applications %}<p>{{ allocation.title | escape }} (−{{ allocation.total_allocated_amount | money }})</p>{% endfor %}<div class="cart-total"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div><div class="cart-note">{% render 'shipping-policy' %}<p>Taxes and any shipping charges are calculated at checkout.</p></div><button type="submit" name="update" class="text-link">Update bag</button><button type="submit" name="checkout" class="button">Checkout</button></form>{% endif %}
