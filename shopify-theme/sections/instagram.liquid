{%- liquid
  assign profile_url = section.settings.profile_url | default: 'https://www.instagram.com/dimohe.store/'
  assign heading = section.settings.heading | default: 'Latest from Instagram'
  assign reels_endpoint = section.settings.reels_endpoint | strip
-%}
{{ 'instagram-reels.css' | asset_url | stylesheet_tag }}
<section class="instagram-reels" data-instagram-reels="{{ reels_endpoint | escape }}" aria-labelledby="instagram-reels-{{ section.id }}">
  <div class="instagram-reels__panel">
    <div class="instagram-reels__copy">
      <span class="instagram-reels__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"/></svg></span>
      <h2 id="instagram-reels-{{ section.id }}">
        {%- if heading == 'Latest from Instagram' -%}
          Latest from <em>Instagram</em>
        {%- else -%}
          {{ heading | escape }}
        {%- endif -%}
      </h2>
      {%- if section.settings.intro != blank -%}
        <p>{{ section.settings.intro | escape }}</p>
      {%- endif -%}
      <a class="instagram-reels__follow" href="{{ profile_url | escape }}" target="_blank" rel="noopener noreferrer">
        <span>{{ section.settings.profile_label | escape }}</span>
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 15 15 5M6 5h9v9"/></svg>
      </a>
    </div>
    <div class="instagram-reels__media">
      <img class="instagram-reels__photo" src="{{ 'instagram-block-print.webp' | asset_url }}" alt="" width="900" height="1200" loading="lazy" decoding="async">
      <img class="instagram-reels__detail" src="{{ 'instagram-embroidery.webp' | asset_url }}" alt="" width="540" height="720" loading="lazy" decoding="async">
      <div class="instagram-reels__player" data-instagram-reel hidden></div>
    </div>
  </div>
</section>
{%- if reels_endpoint == blank and section.blocks.size > 0 -%}
  <div class="section instagram-apps">
    {%- for block in section.blocks -%}
      {% render block %}
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Instagram",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest from Instagram" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "See the craft behind our collections, from block-printed linens to hand-embroidered bags." },
    { "type": "url", "id": "profile_url", "label": "Instagram profile" },
    { "type": "text", "id": "profile_label", "label": "Profile link text", "default": "Follow @dimohe.store" },
    { "type": "text", "id": "reels_endpoint", "label": "Latest reel feed URL", "info": "Enter the public HTTPS URL ending in /api/instagram-reels." }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Instagram" }]
}
{% endschema %}
