{% if section.settings.profile_url != blank or section.blocks.size > 0 %}<section class="section instagram-section"><div class="section-title"><div><p class="eyebrow">Follow along</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.intro | escape }}</p></div>{% if section.settings.profile_url != blank %}<a class="text-link" href="{{ section.settings.profile_url }}" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"/></svg>{{ section.settings.profile_label | escape }}</a>{% endif %}</div>{% if section.blocks.size > 0 %}<div class="instagram-apps">{% for block in section.blocks %}{% render block %}{% endfor %}</div>{% endif %}</section>{% endif %}
{% schema %}
{"name":"Instagram","settings":[{"type":"text","id":"heading","label":"Heading","default":"Dimohe, day to day."},{"type":"textarea","id":"intro","label":"Introduction","default":"New pieces, everyday rituals, and a closer look at the hands behind them."},{"type":"url","id":"profile_url","label":"Instagram profile","default":"https://www.instagram.com/dimohe.store/"},{"type":"text","id":"profile_label","label":"Profile label","default":"@dimohe.store"},{"type":"paragraph","content":"The profile link works without an app. To display an automatic feed, add your authorized Instagram app block below. No sample posts are included."}],"blocks":[{"type":"@app"}],"presets":[{"name":"Instagram"}]}
{% endschema %}
