<section class="section founder-note" id="dimohe-founder"><h2>{{ section.settings.heading | escape }}</h2><div class="founder-body prose">{{ section.settings.body }}</div>{% if section.settings.page != blank %}<a class="text-link" href="{{ section.settings.page.url }}">{{ section.settings.link_label | escape }}</a>{% endif %}</section>

{% schema %}
{
  "name": "Founder note",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet Diksha."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Story",
      "default": "<p>Diksha Agrawal founded Dimohe after moving from India to the United States. She wanted to make the crafts she grew up around easier to find, in pieces that work in a home and wardrobe today.</p>"
    },
    {
      "type": "page",
      "id": "page",
      "label": "Founder page"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Meet our founder"
    }
  ],
  "presets": [
    {
      "name": "Founder note"
    }
  ]
}
{% endschema %}
