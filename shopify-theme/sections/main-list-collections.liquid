<section class="section"><h1>Explore the collections</h1>{% paginate collections by 24 %}<div class="category-grid">{% for collection in collections %}{% unless collection.handle == 'frontpage' %}<a class="category-tile" href="{{ collection.url }}"><div class="category-photo">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: collection.title }}{% else %}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}</div><div class="category-title"><h2>{{ collection.title | escape }}</h2></div></a>{% endunless %}{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}</section>

{% schema %}
{
  "name": "Collections",
  "settings": []
}
{% endschema %}
