<section class="section department-products mixed-explore" aria-labelledby="Explore-{{ section.id }}" data-product-carousel><div class="rail-toolbar"><div><h2 id="Explore-{{ section.id }}">More to explore</h2><p>A few places to start.</p></div><div class="rail-controls"><button class="rail-autoplay" type="button" data-rail-pause aria-label="Pause collection slideshow" aria-pressed="false">Pause</button><button type="button" data-rail-prev aria-label="Previous collections" aria-controls="Rail-{{ section.id }}" disabled><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m14 5-7 7 7 7"/></svg></button><button type="button" data-rail-next aria-label="Next collections" aria-controls="Rail-{{ section.id }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m10 5 7 7-7 7"/></svg></button></div></div><div class="product-rail" id="Rail-{{ section.id }}" role="region" aria-label="Explore collections" tabindex="0">{% for block in section.blocks %}<article class="product-card explore-collection-card" {{ block.shopify_attributes }}><a class="product-image" href="{{ block.settings.collection.url | default: routes.all_products_collection_url }}">{% render 'theme-image', image: block.settings.image, asset: block.settings.asset, alt: block.settings.title, loading: 'lazy', sizes: '(max-width: 767px) 76vw, 35vw' %}</a><div class="product-caption"><h3><a href="{{ block.settings.collection.url | default: routes.all_products_collection_url }}">{{ block.settings.title | escape }}</a></h3></div></article>{% endfor %}</div><p class="rail-hint">Swipe or scroll to explore</p></section>
{% schema %}
{"name":"More to explore","settings":[],"max_blocks":8,"blocks":[{"type":"collection","name":"Collection photo","settings":[{"type":"text","id":"title","label":"Title"},{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Photo"},{"type":"text","id":"asset","label":"Theme photo filename"}]}],"presets":[{"name":"More to explore"}]}
{% endschema %}
