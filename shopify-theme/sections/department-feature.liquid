<section class="chapter-panel"><a class="chapter-photo" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{% render 'theme-image', image: section.settings.image, asset: section.settings.asset, alt: section.settings.heading, loading: 'lazy', sizes: '(max-width: 767px) 100vw, 50vw' %}</a><div class="chapter-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2><a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ section.settings.heading | escape }}</a></h2><p>{{ section.settings.intro | escape }}</p><a class="text-link" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a>{% if section.settings.collection.handle == 'wellness' %}<a class="text-link department-making-link" href="{% render 'craft-url' %}#ayurveda-film">Watch our hair care being made</a>{% endif %}</div></section>
{% assign rail_items = section.settings.products | concat: section.settings.collection.products | uniq %}{% render 'product-rail', items: rail_items, limit: section.settings.product_limit, heading: section.settings.heading, rail_id: section.id %}
{% schema %}
{
  "name": "Department story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collection story"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Story",
      "default": "Discover the details in each piece."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Shop collection"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Explore the collection"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Featured products (optional)",
      "limit": 12
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "asset",
      "label": "Bundled image filename",
      "default": "none"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Department story"
    }
  ]
}
{% endschema %}
