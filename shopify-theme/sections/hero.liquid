<section class="hero"><div class="hero-copy"><h1>{{ section.settings.line_one | escape }}<br><em>{{ section.settings.line_two | escape }}</em><br>{{ section.settings.line_three | escape }}</h1><p>{{ section.settings.intro | escape }}</p><a class="button" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button | escape }}</a></div><div class="hero-photo hero-slideshow" data-hero-slideshow aria-label="Explore the Dimohe collection" aria-roledescription="carousel">{% for block in section.blocks %}<a class="hero-slide{% if forloop.first %} is-active{% endif %}" href="{{ block.settings.collection.url | default: block.settings.link | default: routes.all_products_collection_url }}" data-hero-slide aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"{% unless forloop.first %} tabindex="-1"{% endunless %} {{ block.shopify_attributes }}>{% assign loading = 'lazy' %}{% if forloop.first %}{% assign loading = 'eager' %}{% endif %}{% render 'theme-image', image: block.settings.image, asset: block.settings.asset, alt: block.settings.alt, loading: loading, sizes: '(max-width: 767px) 100vw, 46vw' %}<span class="hero-slide-label">{{ block.settings.title | escape }}</span></a>{% endfor %}<div class="hero-slide-controls"><div class="hero-slide-dots" aria-label="Choose a collection photo">{% for block in section.blocks %}<button type="button" data-hero-dot="{{ forloop.index0 }}" aria-label="Show {{ block.settings.title | escape }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"></button>{% endfor %}</div></div></div></section>

{% schema %}
{
  "name": "Homepage hero",
  "settings": [
    {
      "type": "text",
      "id": "line_one",
      "label": "First headline",
      "default": "Block-printed linens."
    },
    {
      "type": "text",
      "id": "line_two",
      "label": "Second headline",
      "default": "Hand-embroidered bags."
    },
    {
      "type": "text",
      "id": "line_three",
      "label": "Third headline",
      "default": "Ayurveda for everyday."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Block-printed cotton, textured linen, and hand-embroidered raw silk. Indian craft for your home and wardrobe, with Ayurvedic hair and body care for your daily routine."
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "slide",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Bundled image filename",
          "default": "none"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Caption",
          "default": "Collection"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image description",
          "default": "Dimohe collection"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Alternative link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Homepage hero"
    }
  ]
}
{% endschema %}
