<section id="chikankari-film" class="section film-section craft-reel"><div>{% if section.settings.video != blank %}<figure class="film-media">{{ section.settings.video | video_tag: controls: true, playsinline: true, preload: 'none' }}</figure>{% else %}{% render 'making-film-player', asset: 'embroidery-needlework.mp4', poster: 'embroidery-needlework-poster.jpg', title: 'Hand embroidery, up close', caption: 'Hand embroidery · 23 sec', width: 480, height: 848, player_class: 'workroom-primary' %}{% endif %}</div><div class="film-copy"><p class="eyebrow">Stitch by stitch</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.intro | escape }}</p><details class="making-film workroom-detail"><summary>Watch the pattern being drawn <span>+</span></summary>{% render 'making-film-player', asset: 'embroidery-pattern.mp4', poster: 'embroidery-pattern-poster.jpg', title: 'Drawing an embroidery pattern', caption: 'Before the needlework · 23 sec' %}</details><a class="text-link" href="{% render 'collection-url', handle: 'bags' %}">Explore hand-embroidered bags</a></div></section>
{% schema %}
{"name":"Embroidery workroom","settings":[{"type":"text","id":"heading","label":"Heading","default":"Inside the embroidery workroom."},{"type":"textarea","id":"intro","label":"Introduction","default":"A pattern is drawn before the needlework begins. Watch the drawing and stitching up close."},{"type":"video","id":"video","label":"Replace bundled needlework film"}],"presets":[{"name":"Embroidery workroom"}]}
{% endschema %}
