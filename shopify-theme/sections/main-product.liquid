{%- assign current_variant = product.selected_or_first_available_variant -%}
<section class="section product-section"><p class="breadcrumbs"><a href="{{ routes.root_url }}">Home</a> / {% if collection %}<a href="{{ collection.url }}">{{ collection.title | escape }}</a> / {% endif %}{{ product.title | escape }}</p><div class="product-layout"><div class="gallery"><button class="main-photo" type="button" data-zoom aria-label="Enlarge product image">{% assign hero_image = current_variant.featured_image | default: product.featured_image %}{% if hero_image %}{{ hero_image | image_url: width: 1500 | image_tag: id: 'main-product-image', loading: 'eager', widths: '480,750,1100,1500', sizes: '(max-width: 767px) 100vw, 50vw', alt: product.title }}{% endif %}<span>View closer +</span></button><div class="thumbnails">{% for image in product.images %}<button type="button" data-image="{{ image | image_url: width: 1500 }}" aria-label="View image {{ forloop.index }}" aria-pressed="{% if image.id == hero_image.id %}true{% else %}false{% endif %}">{{ image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}</button>{% endfor %}</div>{% for media in product.media %}{% unless media.media_type == 'image' %}<div class="product-media">{{ media | media_tag: image_size: '900x', controls: true }}</div>{% endunless %}{% endfor %}</div><div class="product-info"><p class="eyebrow">{{ product.type | escape }}</p><h1>{{ product.title | escape }}</h1>{% if product.metafields.reviews.rating.value != blank and product.metafields.reviews.rating_count.value > 0 %}<p class="product-rating">{{ product.metafields.reviews.rating.value.rating }} / {{ product.metafields.reviews.rating.value.scale_max }} · {{ product.metafields.reviews.rating_count.value }} reviews</p>{% endif %}<div class="product-price-line"><p class="detail-price" data-product-price>{{ current_variant.price | money }}</p><span class="stock" data-stock>{% render 'stock-label', variant: current_variant, threshold: section.settings.low_stock_threshold %}</span></div>{% if product.metafields.custom.short_description != blank %}<div class="product-summary">{{ product.metafields.custom.short_description | metafield_tag }}</div>{% endif %}<div class="shipping-estimate">{% render 'shipping-policy' %}</div>
{% assign product_form_id = 'ProductForm-' | append: section.id %}{% form 'product', product, id: product_form_id, class: 'product-form', data-product-form: '' %}{% if product.variants.size > 1 %}<label for="Variant-{{ section.id }}">Choose {{ product.options | join: ' / ' | escape }}</label>{% endif %}<select id="Variant-{{ section.id }}" name="id" data-variant-select{% if product.has_only_default_variant or product.variants.size == 1 %} hidden{% endif %}>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-available="{{ variant.available }}" data-stock-label="{% render 'stock-label', variant: variant, threshold: section.settings.low_stock_threshold %}" data-min="{{ variant.quantity_rule.min | default: 1 }}" data-step="{{ variant.quantity_rule.increment | default: 1 }}" data-max="{{ variant.quantity_rule.max }}" data-image="{% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1500 }}{% endif %}"{% if variant.id == current_variant.id %} selected{% endif %}>{{ variant.title | escape }}{% unless variant.available %} · Sold out{% endunless %}</option>{% endfor %}</select>{% if product.requires_selling_plan %}<label for="SellingPlan-{{ section.id }}">Purchase plan</label><select id="SellingPlan-{{ section.id }}" name="selling_plan">{% for group in product.selling_plan_groups %}{% for plan in group.selling_plans %}<option value="{{ plan.id }}">{{ plan.name | escape }}</option>{% endfor %}{% endfor %}</select>{% endif %}<label for="Quantity-{{ section.id }}">Quantity</label><input id="Quantity-{{ section.id }}" type="number" name="quantity" value="{{ current_variant.quantity_rule.min | default: 1 }}" min="{{ current_variant.quantity_rule.min | default: 1 }}" step="{{ current_variant.quantity_rule.increment | default: 1 }}"{% if current_variant.quantity_rule.max %} max="{{ current_variant.quantity_rule.max }}"{% endif %}><button class="button add-to-bag" type="submit" data-add-button{% unless current_variant.available %} disabled{% endunless %}>{% if current_variant.available %}Add to bag{% else %}Sold out{% endif %}</button><p class="form-error" role="status" aria-live="polite"></p>{% endform %}
{% render 'product-share', product: product %}<div class="save-piece"><button class="text-link" type="button" data-save-piece="{{ product.handle }}" data-save-url="{{ product.url }}" aria-pressed="false">Save to wishlist</button><a href="{{ routes.root_url }}?view=saved">View saved pieces</a></div>{% render 'product-information', product: product %}{% render 'product-making-video', product: product %}<details class="product-details" id="shipping-returns"><summary>Shipping & returns <span>+</span></summary><div class="prose">{% render 'shipping-policy' %}{{ section.settings.shipping_returns }}</div></details>{% for block in section.blocks %}{% case block.type %}{% when '@app' %}{% render block %}{% when 'note' %}<details class="product-details" {{ block.shopify_attributes }}><summary>{{ block.settings.title | escape }} <span>+</span></summary><div class="prose">{{ block.settings.body }}</div></details>{% endcase %}{% endfor %}</div></div></section><dialog id="zoom-dialog" class="zoom-dialog"><button class="icon-button" type="button" data-close-dialog aria-label="Close image">{% render 'icon-close' %}</button>{% if hero_image %}{{ hero_image | image_url: width: 2000 | image_tag: alt: product.title }}{% endif %}</dialog>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "richtext",
      "id": "shipping_returns",
      "label": "Shipping and returns",
      "default": "<p>Items must be unused and in their original condition and packaging. Original shipping charges are not refundable.</p>"
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "Low-stock threshold",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 5,
      "info": "Only shown for tracked, positive stock at or below this number; overselling variants are excluded."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "note",
      "name": "Product information",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Details & dimensions"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Content",
          "default": "<p>Add useful product information here.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
