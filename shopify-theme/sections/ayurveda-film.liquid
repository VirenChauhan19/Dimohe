<section id="ayurveda-film" class="section ayurveda-films"><div class="section-title"><div><p class="eyebrow">Ritual by ritual</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.intro | escape }}</p></div><a class="text-link" href="{% render 'collection-url', handle: 'wellness' %}">Explore wellness</a></div>{% if section.settings.video != blank %}<figure class="film-media">{{ section.settings.video | video_tag: controls: true, playsinline: true, preload: 'none' }}</figure>{% else %}<div class="film-collection-grid" role="region" aria-label="Ayurveda product films" tabindex="0">
<article class="film-collection-card">{% render 'making-film-player', asset: 'coconut-shampoo.mp4', poster: 'coconut-shampoo-poster.jpg', title: 'Making coconut shampoo', caption: '23 sec' %}<h3>Coconut shampoo</h3><p>From freshly grated coconut to the preparation vessel.</p><a class="text-link" href="{{ routes.root_url }}products/keshamrit-conditioning-cleansing-shampoo-coconut-milk-250ml">Shop coconut shampoo</a></article>
<article class="film-collection-card">{% render 'making-film-player', asset: 'hibiscus-hair-oil.mp4', poster: 'hibiscus-hair-oil-poster.jpg', title: 'Making hibiscus hair oil', caption: '12 sec' %}<h3>Hibiscus hair oil</h3><p>Flowers and leaves go into the oil.</p><a class="text-link" href="{{ routes.root_url }}products/hibiscus-hair-oil-100ml">Shop hibiscus hair oil</a></article>
<article class="film-collection-card">{% render 'making-film-player', asset: 'ubtan.mp4', poster: 'ubtan-poster.jpg', title: 'Ubtan bathing powder in use', caption: '21 sec · In use' %}<h3>Ubtan bathing powder</h3><p>See the bathing powder applied to the skin.</p><a class="text-link" href="{{ routes.root_url }}products/snanamrit-ubtan-natural-bathing-powder-250gm">Shop ubtan</a></article>
</div><p class="film-swipe-hint">Swipe to see the films</p>{% endif %}</section>
{% schema %}
{"name":"Ayurveda films","settings":[{"type":"text","id":"heading","label":"Heading","default":"Inside our Ayurveda collection."},{"type":"textarea","id":"intro","label":"Introduction","default":"Coconut grated for shampoo. Hibiscus added to oil. Ubtan applied to the skin. Three short films from the collection."},{"type":"video","id":"video","label":"Optional single film instead of the selection"}],"presets":[{"name":"Ayurveda films"}]}
{% endschema %}
