<section class="section embroidery-showcase"><div class="section-title"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.intro | escape }}</p>{% if section.settings.collection != blank %}<a class="text-link" href="{{ section.settings.collection.url }}">{{ section.settings.link_label | escape }}</a>{% endif %}<a class="text-link bag-film-link" href="{% render 'craft-url' %}#chikankari-film">Watch how our bags are made</a></div></div><div class="embroidery-panels">{% for block in section.blocks %}<article class="embroidery-panel{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}><a class="embroidery-photo" href="{{ block.settings.collection.url | default: routes.all_products_collection_url }}">{% render 'theme-image', image: block.settings.image, asset: block.settings.asset, alt: block.settings.title, loading: 'lazy', sizes: '(max-width: 767px) 46vw, 35vw' %}</a><div class="embroidery-caption"><h3><a href="{{ block.settings.collection.url | default: routes.all_products_collection_url }}">{{ block.settings.title | escape }}</a></h3><p>{{ block.settings.detail | escape }}</p></div></article>{% endfor %}</div></section>

{% assign rail_items = section.settings.products | concat: section.settings.collection.products | uniq %}{% render 'product-rail', items: rail_items, limit: section.settings.product_limit, heading: section.settings.heading, rail_id: section.id %}
{% schema %}
{
  "name": "Hand-embroidered bags",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "STITCH BY STITCH"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hand-embroidered bags"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Fine floral needlework and raised hand embroidery, across five bag shapes. In Lucknow, artisans stitch delicate flowers and vines by hand; look closely to see each stitch on raw silk."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Explore bags collection"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Explore bags"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Featured products (optional)",
      "limit": 12
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "type": "shape",
      "name": "Bag shape",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Bag shape"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "One-line detail",
          "default": "Hand embroidery on textured fabric."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Bundled image filename",
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hand-embroidered bags"
    }
  ]
}
{% endschema %}
