<section class="section brand-story customer-account"><h1>Activate account</h1>{% form 'activate_customer_password' %}{{ form.errors | default_errors }}<label>Password<input type="password" name="customer[password]" autocomplete="new-password" required></label><label>Confirm password<input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label><button class="button" type="submit">Activate account</button><button type="submit" name="decline">Decline invitation</button>{% endform %}</section>
