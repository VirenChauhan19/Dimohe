<section class="section brand-story customer-account"><h1>{{ order.name | escape }}</h1><p>{{ order.created_at | date: '%B %d, %Y' }}</p>{% for item in order.line_items %}<p>{{ item.title | escape }} · {{ item.quantity }} · {{ item.final_line_price | money }}</p>{% endfor %}<p>Total: {{ order.total_price | money }}</p><h2>Shipping address</h2>{{ order.shipping_address | format_address }}<h2>Billing address</h2>{{ order.billing_address | format_address }}<a href="{{ routes.account_url }}">Your account</a></section>
