<section class="section brand-story customer-account"><h1>Create account</h1>{% form 'create_customer' %}{{ form.errors | default_errors }}<label>First name<input name="customer[first_name]" autocomplete="given-name"></label><label>Last name<input name="customer[last_name]" autocomplete="family-name"></label><label>Email<input name="customer[email]" type="email" autocomplete="email" required></label><label>Password<input name="customer[password]" type="password" autocomplete="new-password" required></label><button class="button" type="submit">Create account</button>{% endform %}</section>
