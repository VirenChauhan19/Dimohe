<section class="section brand-story customer-account"><h1>Sign in</h1>{% form 'customer_login' %}{{ form.errors | default_errors }}<label>Email<input type="email" name="customer[email]" autocomplete="email" required></label><label>Password<input type="password" name="customer[password]" autocomplete="current-password" required></label><button class="button" type="submit">Sign in</button>{% endform %}<a href="{{ routes.account_register_url }}">Create account</a><h2>Reset your password</h2>{% form 'recover_customer_password' %}{{ form.errors | default_errors }}{% if form.posted_successfully? %}<p>Check your email for a reset link.</p>{% endif %}<label>Email<input name="email" type="email" autocomplete="email" required></label><button class="button" type="submit">Send reset link</button>{% endform %}</section>
