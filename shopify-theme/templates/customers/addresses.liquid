<section class="section brand-story customer-account"><h1>Your addresses</h1>{% paginate customer.addresses by 20 %}{% for address in customer.addresses %}<div>{{ address | format_address }}<form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}"><input type="hidden" name="_method" value="delete"><button type="submit">Delete address</button></form></div>{% endfor %}{{ paginate | default_pagination }}{% endpaginate %}<h2>Add an address</h2>{% form 'customer_address', customer.new_address %}{{ form.errors | default_errors }}<label>First name<input name="address[first_name]" autocomplete="given-name"></label><label>Last name<input name="address[last_name]" autocomplete="family-name"></label><label>Street address<input name="address[address1]" autocomplete="address-line1" required></label><label>Apartment or suite<input name="address[address2]" autocomplete="address-line2"></label><label>City<input name="address[city]" autocomplete="address-level2" required></label><label>Country<select name="address[country]" autocomplete="country-name">{{ all_country_option_tags }}</select></label><label>State or province<input name="address[province]" autocomplete="address-level1"></label><label>Postal code<input name="address[zip]" autocomplete="postal-code" required></label><label>Phone<input name="address[phone]" type="tel" autocomplete="tel"></label><button class="button" type="submit">Save address</button>{% endform %}</section>
