{% layout none %}<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ shop.name | escape }} gift card</title>{{ 'dimohe.css' | asset_url | stylesheet_tag }}</head><body><main class="section brand-story"><h1>{{ shop.name | escape }} gift card</h1><p>{{ gift_card.balance | money }}</p>{% if gift_card.enabled %}<p>{{ gift_card.code | format_code }}</p>{% else %}<p>This gift card is not active.</p>{% endif %}<a class="button" href="{{ shop.url }}">Shop the collection</a></main></body></html>
